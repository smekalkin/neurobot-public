# Telegram identity and destination.
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_BOT_USERNAME=ExampleAgentBot
TELEGRAM_CHAT_ID=-1000000000000
TELEGRAM_THREAD_ID=100
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_ALLOW_ALL_CHAT_MEMBERS=false
TELEGRAM_RETRY_ATTEMPTS=3

# Agent identity. The key must exist in peers.json when peer routing is used.
NEUROBOT_AGENT_KEY=assistant
NEUROBOT_AGENT_DISPLAY_NAME="Example Assistant"
NEUROBOT_AGENT_HELP_TEXT="Helps with configured work tasks."
NEUROBOT_PEERS_FILE=/etc/neurobot/peers.json
NEUROBOT_MAX_ROUTE_HOPS=3

# Optional files and Telegram acknowledgement.
NEUROBOT_ATTACHMENT_DIRS=reports,exports,artifacts
NEUROBOT_MAX_DOCUMENT_BYTES=50331648
NEUROBOT_ACK_REACTION=👀

# Optional daily schedule.
NEUROBOT_DAILY_ENABLED=false
NEUROBOT_DAILY_TIME=09:00
NEUROBOT_DAILY_TIMEZONE=UTC

# Executor: codex, claude, deepseek or hybrid.
NEUROBOT_EXECUTOR=codex
AGENT_WORKSPACE=/srv/neurobot-agent/workspace

# Codex executor.
CODEX_HOME=/srv/neurobot-agent/.codex
CODEX_APP_SERVER_SOCKET=/srv/neurobot-agent/.codex/app-server-control/app-server-control.sock
CODEX_DEFAULT_THREAD_ID=replace-with-thread-id
CODEX_THREAD_NAME="Neurobot Agent"
CODEX_TIMEOUT=900
CODEX_MIN_REMAINING_PERCENT=10
CODEX_RATE_LIMIT_FAIL_CLOSED=true

# Claude executor. Uncomment and adapt when selected.
#CLAUDE_BIN=claude
#CLAUDE_CONFIG_DIR=/srv/neurobot-agent/.claude
#CLAUDE_DEFAULT_SESSION_ID=replace-with-session-id
#CLAUDE_TIMEOUT=3600
#CLAUDE_EXTRA_ARGS=--dangerously-skip-permissions

# DeepSeek executor. Store the provider key in the referenced protected file.
#DEEPSEEK_ENV_FILE=/etc/neurobot/deepseek.env
#DEEPSEEK_MODEL=deepseek-chat
#DEEPSEEK_TIMEOUT=900

LOG_LEVEL=INFO
